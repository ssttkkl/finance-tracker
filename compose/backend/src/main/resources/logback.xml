<configuration>
    <property name="LOG_PATTERN" value="%date{ISO8601,UTC} %-5level %logger - %msg%nopex%n"/>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <!-- The statement parser worker reserves stdout for its binary protocol. -->
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    <logger name="com.finance.tracker.diagnostics" level="INFO" additivity="false">
        <appender-ref ref="STDOUT"/>
    </logger>
    <!-- The Ktor environment logger can render raw request URIs. -->
    <logger name="io.ktor.server.Application" level="OFF"/>
    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
