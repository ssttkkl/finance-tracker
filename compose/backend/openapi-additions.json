  "paths": {
    "/api/v1/cash-import/pdf/parse": {
      "post": {
        "operationId": "parseCashPdf",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "additionalProperties": {
                  "format": "binary",
                  "type": "string"
                },
                "description": "Exactly one file:<client_file_ref> binary part and JSON metadata. File limit 100 MiB; total request limit 101 MiB. Password stays in metadata, never in the URL.",
                "properties": {
                  "metadata": {
                    "contentMediaType": "application/json",
                    "contentSchema": {
                      "additionalProperties": false,
                      "properties": {
                        "files": {
                          "items": {
                            "additionalProperties": false,
                            "properties": {
                              "client_file_ref": {
                                "pattern": "^[A-Za-z0-9_-]{1,128}$",
                                "title": "Client File Ref",
                                "type": "string"
                              },
                              "last_modified_at_ms": {
                                "anyOf": [
                                  {
                                    "exclusiveMaximum": 9.223372036854776e+18,
                                    "minimum": 0.0,
                                    "type": "integer"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "title": "Last Modified At Ms"
                              },
                              "password": {
                                "anyOf": [
                                  {
                                    "maxLength": 1024,
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "title": "Password"
                              },
                              "source_hint": {
                                "anyOf": [
                                  {
                                    "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                                    "type": "string"
                                  },
                                  {
                                    "type": "null"
                                  }
                                ],
                                "title": "Source Hint"
                              }
                            },
                            "required": [
                              "client_file_ref"
                            ],
                            "title": "UploadFileMetadata",
                            "type": "object"
                          },
                          "maxItems": 1,
                          "minItems": 1,
                          "title": "Files",
                          "type": "array"
                        }
                      },
                      "required": [
                        "files"
                      ],
                      "title": "UploadMetadata",
                      "type": "object"
                    },
                    "type": "string"
                  }
                },
                "required": [
                  "metadata"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CashPdfParseResultDto"
                }
              }
            },
            "description": "Normalized document only; no ledger reads or writes, session or persisted file"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Write access or original workspace no longer available"
          },
          "413": {
            "description": "Request or file exceeds budget"
          },
          "422": {
            "description": "Invalid multipart metadata, file count, PDF, source or password"
          },
          "503": {
            "description": "Parser temporarily busy or timed out"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Parse one PDF without persisting import state",
        "tags": [
          "cash-import"
        ]
      }
    },
    "/api/v1/ledger/snapshot": {
      "get": {
        "operationId": "getLedgerSnapshot",
        "parameters": [
          {
            "description": "Expected selected workspace for the local cache. A mismatch is forbidden; it does not select a workspace.",
            "in": "query",
            "name": "workspace_id",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerSnapshot"
                }
              }
            },
            "description": "Complete consistent canonical cash facts"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Selected workspace is not accessible"
          },
          "503": {
            "description": "Storage unavailable"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Read all canonical facts at one selected-workspace version",
        "tags": [
          "ledger-sync"
        ]
      }
    },
    "/api/v1/ledger/version": {
      "get": {
        "operationId": "getLedgerVersion",
        "parameters": [
          {
            "description": "Expected selected workspace for the local cache. A mismatch is forbidden; it does not select a workspace.",
            "in": "query",
            "name": "workspace_id",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerVersion"
                }
              }
            },
            "description": "Current authoritative ledger version"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Selected workspace is not accessible"
          },
          "503": {
            "description": "Storage unavailable"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Read the selected workspace ledger version",
        "tags": [
          "ledger-sync"
        ]
      }
    }
  }
