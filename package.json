{
  "name": "finance-tracker-monorepo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [],
  "scripts": {
    "tokens:generate": "python scripts/generate_ui_tokens.py",
    "compose:test": "cd compose && ./gradlew :shared:wasmJsTest --no-configuration-cache",
    "compose:build:web": "cd compose && ./gradlew :webApp:wasmJsBrowserDistribution --no-configuration-cache",
    "compose:build:android": "cd compose && ./gradlew :androidApp:assembleDebug --no-configuration-cache",
    "compose:build:ios": "cd compose && ./gradlew :shared:iosSimulatorArm64Test :shared:linkDebugFrameworkIosSimulatorArm64 --no-configuration-cache",
    "compose:demo": "node web/scripts/start-compose-demo.mjs",
    "pen:version": "pen version"
  },
  "devDependencies": {
    "@pen.dev/cli": "0.3.9"
  }
}
