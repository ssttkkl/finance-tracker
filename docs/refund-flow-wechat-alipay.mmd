flowchart TD
    subgraph ALIPAY[支付宝退款识别与配对]
        A1[支付宝账单行] --> A2{是否退款?}
        A2 -- 交易状态=退款成功 --> A3[alipay_status]
        A2 -- 交易分类=退款 且 收支=不计收支 --> A4[alipay_category_nocount]
        A2 -- 商品说明含退款语义 --> A5[alipay_desc]
        A3 --> A6[进入退款配对]
        A4 --> A6
        A5 --> A6
        A6 --> A7[商家订单号匹配]
        A7 --> A8{命中?}
        A8 -- 否 --> A9[退款交易号 base 匹配]
        A9 --> A10{命中?}
        A10 -- 否 --> A11[描述业务单号匹配]
        A11 --> A12{命中?}
        A12 -- 否 --> A13[交易对方 cp 匹配]
        A13 --> A14{命中?}
        A14 -- 否 --> A15[description fallback / gross candidate]
        A8 -- 是 --> A16[候选集]
        A10 -- 是 --> A16
        A12 -- 是 --> A16
        A14 -- 是 --> A16
        A15 --> A16
        A16 --> A17[排序: 精确金额 > 描述更像 > 最近消费]
    end

    subgraph WECHAT[微信退款识别与配对]
        W1[微信账单行] --> W2{是否退款?}
        W2 -- 收入 且 当前状态含退款 --> W3[wechat_status]
        W2 -- 支出 且 当前状态含退款 --> W4[原消费可被退款]
        W3 --> W5[进入退款配对]
        W5 --> W6[订单级候选]
        W6 --> W7{命中?}
        W7 -- 否 --> W8[微信专用候选]
        W8 --> W81[设备号]
        W8 --> W82[美团订单号]
        W8 --> W83[美团收银号]
        W8 --> W84[稳定 token]
        W8 --> W85[品牌别名归一化]
        W81 --> W9{命中?}
        W82 --> W9
        W83 --> W9
        W84 --> W9
        W85 --> W9
        W9 -- 否 --> W10[交易对方 cp 匹配]
        W10 --> W11{命中?}
        W11 -- 否 --> W12[description fallback]
        W12 --> W13{命中?}
        W13 -- 否 --> W14[gross candidate]
        W14 --> W15{命中?}
        W7 -- 是 --> W16[候选集]
        W9 -- 是 --> W16
        W11 -- 是 --> W16
        W13 -- 是 --> W16
        W15 -- 是 --> W16
        W15 -- 否 --> W17[孤退款保留为 income]
        W16 --> W18[排序: 精确金额 > 描述更像 > 最近消费]
    end

    A17 --> X[统一 strong / weak 判定]
    W18 --> X
    X --> Y[自动核销或进入 pending]
